{
	"name": "Agg_TripDetails",
	"properties": {
		"activities": [
			{
				"name": "Agg_TripDetails",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "SELECT medallion,\n    COUNT(*) as [trip_count],\n    SUM(trip_distance) as [total_distance],\n    AVG(trip_distance) as [avg_distance]       ,\n    SUM(trip_time_in_secs) as [total_trip_time_secs],\n    AVG(CAST(passenger_count AS DECIMAL(5,2))) as     [avg_passengers]     ,\n    MAX(trip_distance) as [longest_trip]       \nFROM TripDetails\nGROUP BY medallion;\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "SqlDWSink",
						"preCopyScript": "TRUNCATE TABLE [dbo].[Agg_TripDetails]",
						"writeBehavior": "Insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "Staging",
							"type": "LinkedServiceReference"
						},
						"path": "aggregation/staging/Agg_TripDetails"
					},
					"logSettings": {
						"enableCopyActivityLog": true,
						"copyActivityLogSettings": {
							"logLevel": "Info",
							"enableReliableLogging": false
						},
						"logLocationSettings": {
							"linkedServiceName": {
								"referenceName": "Logging",
								"type": "LinkedServiceReference"
							},
							"path": "aggregation/logging/Agg_TripDetails"
						}
					},
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "SqlServerTable2",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Agg_TripDetails",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}